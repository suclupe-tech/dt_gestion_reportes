<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dt_gestion_reportes.DashboardTiendas">

        <div class="d-flex" style="height: calc(100vh - 48px); overflow: hidden;">

            <!-- MENÚ LATERAL INTERNO -->
            <div class="bg-white border-end"
                style="width: 210px; min-width: 210px; overflow-y: auto;">

                <div class="p-3 border-bottom">
                    <h5 class="mb-0">Tableros</h5>
                </div>

                <div class="p-3">

                    <div class="text-uppercase fw-bold text-muted small mb-2">
                        Ventas
                    </div>

                    <button type="button"
                            t-att-class="'btn w-100 text-start mb-1 ' + (state.activeSection === 'ventas_pos' ? 'btn-primary' : 'btn-light')"
                            t-on-click="() => this.setSection('ventas_pos')">
                        Ventas POS
                    </button>

                    <button type="button"
                            t-att-class="'btn w-100 text-start mb-3 ' + (state.activeSection === 'productos' ? 'btn-primary' : 'btn-light')"
                            t-on-click="() => this.setSection('productos')">
                        Productos
                    </button>

                    <div class="text-uppercase fw-bold text-muted small mb-2">
                        Logística
                    </div>

                    <button type="button"
                            t-att-class="'btn w-100 text-start mb-3 ' + (state.activeSection === 'stock' ? 'btn-primary' : 'btn-light')"
                            t-on-click="() => this.setSection('stock')">
                        Stock / Almacén
                    </button>

                    <div class="text-uppercase fw-bold text-muted small mb-2">
                        Producción
                    </div>

                    <button type="button"
                            t-att-class="'btn w-100 text-start mb-3 ' + (state.activeSection === 'produccion' ? 'btn-primary' : 'btn-light')"
                            t-on-click="() => this.setSection('produccion')">
                        Producción
                    </button>

                    <div class="text-uppercase fw-bold text-muted small mb-2">
                        Finanzas
                    </div>

                    <button type="button"
                            t-att-class="'btn w-100 text-start mb-3 ' + (state.activeSection === 'caja' ? 'btn-primary' : 'btn-light')"
                            t-on-click="() => this.setSection('caja')">
                        Caja / Liquidación
                    </button>

                    <div class="text-uppercase fw-bold text-muted small mb-2">
                        SUNAT
                    </div>

                    <button type="button"
                            t-att-class="'btn w-100 text-start mb-1 ' + (state.activeSection === 'sunat' ? 'btn-primary' : 'btn-light')"
                            t-on-click="() => this.setSection('sunat')">
                        Estado SUNAT
                    </button>

                </div>
            </div>

            <!-- CONTENIDO PRINCIPAL -->
            <div class="flex-grow-1 p-3"
                style="min-width: 0; overflow-y: auto; overflow-x: hidden;">

                <!-- DASHBOARD VENTAS POS -->
                <t t-if="state.activeSection === 'ventas_pos'">

                    <!-- CABECERA -->
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h2 class="mb-0">Dashboard Tiendas</h2>
                            <small class="text-muted">Ventas POS</small>
                        </div>

                        <div class="d-flex align-items-end gap-2">
                            <div>
                                <label class="form-label mb-1">Desde</label>
                                <input type="date"
                                       class="form-control"
                                       t-att-value="state.filters.date_from"
                                       t-on-change="onChangeDateFrom"/>
                            </div>

                            <div>
                                <label class="form-label mb-1">Hasta</label>
                                <input type="date"
                                       class="form-control"
                                       t-att-value="state.filters.date_to"
                                       t-on-change="onChangeDateTo"/>
                            </div>

                            <div>
                                <label class="form-label mb-1">Punto de venta</label>
                                <select class="form-select"
                                        t-att-value="state.filters.pos_config_id"
                                        t-on-change="onChangePosConfig">
                                    <option value="">Todos</option>
                                    <t t-foreach="state.data.puntos_venta" t-as="pos" t-key="pos.id">
                                        <option t-att-value="pos.id">
                                            <t t-esc="pos.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <button class="btn btn-primary" t-on-click="loadData">
                                Actualizar
                            </button>

                            <button class="btn btn-secondary" t-on-click="openOrders">
                                Ver órdenes
                            </button>
                        </div>
                    </div>

                    <!-- CARGANDO -->
                    <t t-if="state.loading">
                        <div class="alert alert-info">
                            Cargando datos del dashboard...
                        </div>
                    </t>

                    <!-- CONTENIDO -->
                    <t t-else="">

                        <div class="alert alert-success py-2">
                            Datos cargados correctamente desde POS.
                        </div>

                        <!-- TARJETAS KPI -->
                        <div class="row mt-3">

                            <div class="col-md-2 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <small>Ventas del periodo</small>
                                        <h4 class="mb-0">S/ <t t-esc="formatMoney(state.data.ventas_hoy)"/></h4>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-2 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <small>Órdenes del periodo</small>
                                        <h4 class="mb-0"><t t-esc="state.data.ordenes_hoy"/></h4>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-2 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <small>Ticket promedio</small>
                                        <h4 class="mb-0">S/ <t t-esc="formatMoney(state.data.ticket_promedio)"/></h4>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-2 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <small>Prendas vendidas</small>
                                        <h4 class="mb-0"><t t-esc="state.data.prendas_vendidas"/></h4>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-2 mb-3">
                                <div class="card shadow-sm border-danger h-100">
                                    <div class="card-body py-3">
                                        <small>Errores SUNAT</small>
                                        <h4 class="mb-2"><t t-esc="state.data.sunat_error"/></h4>

                                        <button class="btn btn-sm btn-outline-danger"
                                                t-on-click="openSunatErrors">
                                            Ver errores
                                        </button>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- FILA 1: 3 TABLAS -->
                        <div class="row mt-2">

                            <!-- VENTAS POR TIENDA -->
                            <div class="col-xl-4 col-lg-6 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <h5 class="mb-3">Ventas por tienda</h5>

                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Tienda</th>
                                                    <th class="text-end">Órdenes</th>
                                                    <th class="text-end">Ventas</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="state.data.ventas_por_tienda.length">
                                                    <t t-foreach="state.data.ventas_por_tienda" t-as="line" t-key="line.tienda">
                                                        <tr>
                                                            <td><t t-esc="line.tienda"/></td>
                                                            <td class="text-end"><t t-esc="line.ordenes"/></td>
                                                            <td class="text-end">S/ <t t-esc="formatMoney(line.ventas)"/></td>
                                                        </tr>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <tr>
                                                        <td colspan="3" class="text-center text-muted">
                                                            Sin ventas.
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- VENTAS POR MEDIO DE PAGO -->
                            <div class="col-xl-4 col-lg-6 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <h5 class="mb-3">Ventas por medio de pago</h5>

                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Medio</th>
                                                    <th class="text-end">Ops.</th>
                                                    <th class="text-end">Monto</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="state.data.ventas_por_medio.length">
                                                    <t t-foreach="state.data.ventas_por_medio" t-as="line" t-key="line.medio">
                                                        <tr>
                                                            <td><t t-esc="line.medio"/></td>
                                                            <td class="text-end"><t t-esc="line.cantidad"/></td>
                                                            <td class="text-end">S/ <t t-esc="formatMoney(line.monto)"/></td>
                                                        </tr>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <tr>
                                                        <td colspan="3" class="text-center text-muted">
                                                            Sin pagos.
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- VENTAS POR DOCUMENTO -->
                            <div class="col-xl-4 col-lg-6 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <h5 class="mb-3">Ventas por documento</h5>

                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Documento</th>
                                                    <th class="text-end">Órdenes</th>
                                                    <th class="text-end">Monto</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="state.data.ventas_por_documento.length">
                                                    <t t-foreach="state.data.ventas_por_documento" t-as="line" t-key="line.tipo">
                                                        <tr>
                                                            <td><t t-esc="line.tipo"/></td>
                                                            <td class="text-end"><t t-esc="line.ordenes"/></td>
                                                            <td class="text-end">S/ <t t-esc="formatMoney(line.monto)"/></td>
                                                        </tr>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <tr>
                                                        <td colspan="3" class="text-center text-muted">
                                                            Sin documentos.
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- FILA 2: 3 TABLAS -->
                        <div class="row mt-2">

                            <!-- TOP PRODUCTOS -->
                            <div class="col-xl-4 col-lg-6 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <h5 class="mb-3">Top productos vendidos</h5>

                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Producto</th>
                                                    <th class="text-end">Cant.</th>
                                                    <th class="text-end">Monto</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="state.data.top_productos.length">
                                                    <t t-foreach="state.data.top_productos" t-as="line" t-key="line.producto">
                                                        <tr>
                                                            <td><t t-esc="line.producto"/></td>
                                                            <td class="text-end"><t t-esc="line.cantidad"/></td>
                                                            <td class="text-end">S/ <t t-esc="formatMoney(line.monto)"/></td>
                                                        </tr>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <tr>
                                                        <td colspan="3" class="text-center text-muted">
                                                            Sin productos.
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- ESTADO SUNAT -->
                            <div class="col-xl-4 col-lg-6 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <h5 class="mb-3">Estado SUNAT</h5>

                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Estado</th>
                                                    <th class="text-end">Cantidad</th>
                                                    <th class="text-end">Monto</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="state.data.estado_sunat.length">
                                                    <t t-foreach="state.data.estado_sunat" t-as="line" t-key="line.estado">
                                                        <tr>
                                                            <td><t t-esc="line.estado"/></td>
                                                            <td class="text-end"><t t-esc="line.cantidad"/></td>
                                                            <td class="text-end">S/ <t t-esc="formatMoney(line.monto)"/></td>
                                                        </tr>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <tr>
                                                        <td colspan="3" class="text-center text-muted">
                                                            Sin estados SUNAT.
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- ANULACIONES Y DEVOLUCIONES -->
                            <div class="col-xl-4 col-lg-6 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <h5 class="mb-3">Anulaciones y devoluciones</h5>

                                        <div class="mb-2 d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-danger"
                                                    t-on-click="openAnulaciones">
                                                Ver anulaciones
                                            </button>

                                            <button class="btn btn-sm btn-outline-warning"
                                                    t-on-click="openDevoluciones">
                                                Ver devoluciones
                                            </button>
                                        </div>

                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Concepto</th>
                                                    <th class="text-end">Cant.</th>
                                                    <th class="text-end">Monto</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="state.data.anulaciones_devoluciones.length">
                                                    <t t-foreach="state.data.anulaciones_devoluciones" t-as="line" t-key="line.concepto">
                                                        <tr>
                                                            <td><t t-esc="line.concepto"/></td>
                                                            <td class="text-end"><t t-esc="line.cantidad"/></td>
                                                            <td class="text-end">S/ <t t-esc="formatMoney(line.monto)"/></td>
                                                        </tr>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <tr>
                                                        <td colspan="3" class="text-center text-muted">
                                                            Sin anulaciones ni devoluciones.
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </t>

                </t>

                <!-- SECCIÓN PRODUCTOS -->
                <t t-if="state.activeSection === 'productos'">
                    <div class="mb-3">
                        <h3 class="mb-0">Dashboard Productos</h3>
                        <small class="text-muted">
                            Análisis de productos vendidos, rotación y productos sin movimiento
                        </small>
                    </div>

                    <!-- Filtros -->
                    <div class="card shadow-sm mb-3">
                        <div class="card-body py-3">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-3">
                                    <label class="form-label">Fecha desde</label>
                                    <input type="date"
                                        class="form-control"
                                        t-att-value="state.productosFilters.date_from"
                                        t-on-change="onChangeProductosDateFrom"/>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Fecha hasta</label>
                                    <input type="date"
                                        class="form-control"
                                        t-att-value="state.productosFilters.date_to"
                                        t-on-change="onChangeProductosDateTo"/>
                                </div>

                                <div class="col-md-3">
                                    <label class="form-label">Punto de venta</label>
                                    <select class="form-select"
                                            t-att-value="state.productosFilters.pos_config_id"
                                            t-on-change="onChangeProductosPosConfig">
                                        <option value="">Todos</option>
                                        <t t-foreach="state.productosData.puntos_venta" t-as="pos" t-key="pos.id">
                                            <option t-att-value="pos.id">
                                                <t t-esc="pos.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <button class="btn btn-primary w-100"
                                            t-on-click="loadProductosData">
                                        Aplicar filtros
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <t t-if="state.productosLoading">
                        <div class="alert alert-info">
                            Cargando información de productos...
                        </div>
                    </t>

                    <t t-else="">
                        <!-- KPIs -->
                        <div class="row g-3 mb-3">
                            <div class="col-xl-3 col-md-6">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body">
                                        <small class="text-muted">Total productos vendidos</small>
                                        <h3 class="mb-0">
                                            <t t-esc="state.productosData.total_productos_vendidos"/>
                                        </h3>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-3 col-md-6">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body">
                                        <small class="text-muted">Productos vendidos distintos</small>
                                        <h3 class="mb-0">
                                            <t t-esc="state.productosData.productos_vendidos_distintos"/>
                                        </h3>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-3 col-md-6">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body">
                                        <small class="text-muted">Producto más vendido</small>
                                        <h6 class="mb-0">
                                            <t t-esc="state.productosData.producto_mas_vendido || '-'"/>
                                        </h6>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-3 col-md-6">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body">
                                        <small class="text-muted">Productos sin movimiento</small>
                                        <h3 class="mb-0">
                                            <t t-esc="state.productosData.productos_sin_movimiento"/>
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tablas -->
                        <div class="row mt-2">
                            <!-- Top productos vendidos -->
                            <div class="col-xl-6 col-lg-12 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <h5 class="mb-3">Top productos más vendidos</h5>

                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Producto</th>
                                                    <th class="text-end">Cantidad</th>
                                                    <th class="text-end">Total</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="state.productosData.top_productos.length">
                                                    <t t-foreach="state.productosData.top_productos" t-as="line" t-key="line.producto">
                                                        <tr>
                                                            <td>
                                                                <t t-esc="line.producto"/>
                                                            </td>
                                                            <td class="text-end">
                                                                <t t-esc="line.cantidad"/>
                                                            </td>
                                                            <td class="text-end">
                                                                S/ <t t-esc="formatMoney(line.total)"/>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <tr>
                                                        <td colspan="3" class="text-center text-muted">
                                                            No hay productos vendidos en el periodo.
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Productos con stock pero sin venta -->
                            <div class="col-xl-6 col-lg-12 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <h5 class="mb-3">Productos con stock pero sin venta</h5>

                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Producto</th>
                                                    <th class="text-end">Stock actual</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="state.productosData.productos_sin_movimiento_lista.length">
                                                    <t t-foreach="state.productosData.productos_sin_movimiento_lista" t-as="line" t-key="line.producto">
                                                        <tr>
                                                            <td>
                                                                <t t-esc="line.producto"/>
                                                            </td>
                                                            <td class="text-end">
                                                                <t t-esc="line.stock"/>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <tr>
                                                        <td colspan="2" class="text-center text-muted">
                                                            No hay productos con stock sin venta.
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- SECCIÓN STOCK -->
                <t t-if="state.activeSection === 'stock'">

                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h2 class="mb-0">Dashboard Stock / Almacén</h2>
                            <small class="text-muted">Stock disponible por almacén</small>
                        </div>

                        <div class="d-flex align-items-end gap-2">
                            <div>
                                <label class="form-label mb-1">Almacén</label>
                                <select class="form-select"
                                        t-att-value="state.stockFilters.warehouse_id"
                                        t-on-change="onChangeWarehouse">
                                    <option value="">Todos</option>
                                    <t t-foreach="state.stockData.almacenes" t-as="warehouse" t-key="warehouse.id">
                                        <option t-att-value="warehouse.id">
                                            <t t-esc="warehouse.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>

                            <button class="btn btn-primary" t-on-click="loadStockData">
                                Actualizar
                            </button>
                        </div>
                    </div>

                    <t t-if="state.stockLoading">
                        <div class="alert alert-info">
                            Cargando datos de stock...
                        </div>
                    </t>

                    <t t-else="">

                        <div class="alert alert-success py-2">
                            Datos de stock cargados correctamente.
                        </div>

                        <!-- KPI STOCK -->
                        <div class="row mt-3">

                            <div class="col-md-3 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <small>Total unidades disponibles</small>
                                        <h4 class="mb-0">
                                            <t t-esc="state.stockData.total_unidades"/>
                                        </h4>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <small>Productos con stock</small>
                                        <h4 class="mb-0">
                                            <t t-esc="state.stockData.productos_con_stock"/>
                                        </h4>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3">
                                <div class="card shadow-sm border-danger h-100">
                                    <div class="card-body py-3">
                                        <small>Productos sin stock</small>
                                        <h4 class="mb-0">
                                            <t t-esc="state.stockData.productos_sin_stock"/>
                                        </h4>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3">
                                <div class="card shadow-sm border-warning h-100">
                                    <div class="card-body py-3">
                                        <small>Productos con stock bajo</small>
                                        <h4 class="mb-0">
                                            <t t-esc="state.stockData.productos_stock_bajo"/>
                                        </h4>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- TABLA STOCK POR ALMACÉN -->
                        <div class="row mt-2">
                            <div class="col-xl-6 col-lg-12 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <h5 class="mb-3">Stock por almacén</h5>

                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Almacén</th>
                                                    <th class="text-end">Productos</th>
                                                    <th class="text-end">Unidades disponibles</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="state.stockData.stock_por_almacen.length">
                                                    <t t-foreach="state.stockData.stock_por_almacen" t-as="line" t-key="line.almacen">
                                                        <tr>
                                                            <td><t t-esc="line.almacen"/></td>
                                                            <td class="text-end"><t t-esc="line.productos"/></td>
                                                            <td class="text-end"><t t-esc="line.unidades"/></td>
                                                        </tr>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <tr>
                                                        <td colspan="3" class="text-center text-muted">
                                                            No hay stock disponible para mostrar.
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>

                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-6 col-lg-12 mb-3">
                                <div class="card shadow-sm h-100">
                                    <div class="card-body py-3">
                                        <h5 class="mb-3">Productos con stock bajo</h5>

                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Producto</th>
                                                    <th>Almacén</th>
                                                    <th class="text-end">Stock</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-if="state.stockData.productos_stock_bajo_lista.length">
                                                    <t t-foreach="state.stockData.productos_stock_bajo_lista" t-as="line" t-key="line.producto + line.almacen">
                                                        <tr>
                                                            <td><t t-esc="line.producto"/></td>
                                                            <td><t t-esc="line.almacen"/></td>
                                                            <td class="text-end"><t t-esc="line.stock"/></td>
                                                        </tr>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <tr>
                                                        <td colspan="3" class="text-center text-muted">
                                                            No hay productos con stock bajo.
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </t>
                </t>

                <!-- SECCIÓN PRODUCCIÓN -->
                <t t-if="state.activeSection === 'produccion'">
                    <h2>Producción</h2>
                    <div class="alert alert-info">
                        Pendiente de configurar: producción por área, órdenes en proceso y avance.
                    </div>
                </t>

                <!-- SECCIÓN CAJA -->
                <t t-if="state.activeSection === 'caja'">
                    <h2>Caja / Liquidación</h2>
                    <div class="alert alert-info">
                        Pendiente de configurar: liquidación, efectivo esperado, egresos e ingresos.
                    </div>
                </t>

                <!-- SECCIÓN SUNAT -->
                <t t-if="state.activeSection === 'sunat'">
                    <h2>Estado SUNAT</h2>
                    <div class="alert alert-info">
                        Pendiente de configurar: documentos aceptados, pendientes, errores y resúmenes diarios.
                    </div>
                </t>

            </div>
        </div>
    </t>

</templates>