<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_order_tree_dt_clean_accounting" model="ir.ui.view">
        <field name="name">pos.order.tree.dt.clean.accounting</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <!-- OCULTAR COLUMNAS QUE NO NECESITAS -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath expr="//field[@name='session_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath expr="//field[@name='pos_reference']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath expr="//field[@name='tracking_number']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_status']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <xpath expr="//field[@name='is_edited']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <!-- FECHA -->
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="string">Fecha</attribute>
                <attribute name="optional">show</attribute>
            </xpath>

            <!-- PUNTO DE VENTA -->
            <xpath expr="//field[@name='config_id']" position="attributes">
                <attribute name="string">Punto de venta</attribute>
                <attribute name="optional">show</attribute>
            </xpath>

            <!-- CLIENTE -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">Cliente</attribute>
                <attribute name="optional">show</attribute>
            </xpath>

            <!-- EMPLEADO -->
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="string">Empleado</attribute>
                <attribute name="optional">show</attribute>
            </xpath>

            <!-- TOTAL -->
            <xpath expr="//field[@name='amount_total']" position="attributes">
                <attribute name="string">Total</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            
            <!-- AGREGAR MEDIO DE PAGO, SUBTOTAL E IGV ANTES DEL TOTAL -->
            <xpath expr="//field[@name='amount_total']" position="before">

                <field name="dt_payment_methods"
                        string="Medio de pago"
                        optional="show"/>

                <field name="dt_amount_untaxed"
                        string="Subtotal"
                        widget="monetary"
                        optional="show"/>

                <field name="dt_amount_tax"
                        string="IGV"
                        widget="monetary"
                        optional="show"/>

            </xpath>

        </field>
    </record>

</odoo>